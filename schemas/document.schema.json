{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SciMemo document v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "paper"
        },
        "data": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "summary": {
              "type": "string"
            },
            "stage": {
              "enum": [
                "idea",
                "experiments",
                "writing",
                "revising",
                "paused",
                "finished"
              ]
            },
            "nextAction": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "archived": {
              "type": "boolean"
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "venueId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "priority": {
                    "type": "integer"
                  }
                },
                "required": [
                  "venueId",
                  "reason",
                  "priority"
                ],
                "additionalProperties": false
              }
            },
            "submissions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "venueId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "editionId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "venueNameSnapshot": {
                    "type": "string"
                  },
                  "titleSnapshot": {
                    "type": "string"
                  },
                  "manuscriptNumber": {
                    "type": "string"
                  },
                  "submittedOn": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "date"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "status": {
                          "enum": [
                            "submitted",
                            "editorial",
                            "under_review",
                            "major_revision",
                            "minor_revision",
                            "resubmitted",
                            "accepted",
                            "rejected",
                            "withdrawn"
                          ]
                        },
                        "occurredOn": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "recordedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "note": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "status",
                        "occurredOn",
                        "recordedAt",
                        "note"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "id",
                  "venueId",
                  "editionId",
                  "venueNameSnapshot",
                  "titleSnapshot",
                  "manuscriptNumber",
                  "submittedOn",
                  "events"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "title",
            "summary",
            "stage",
            "nextAction",
            "tags",
            "archived",
            "targets",
            "submissions"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "data",
        "createdAt",
        "updatedAt",
        "version",
        "deleted"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "note"
        },
        "data": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string",
              "minLength": 1
            },
            "noteType": {
              "enum": [
                "idea",
                "note",
                "progress"
              ]
            },
            "paperIds": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pinned": {
              "type": "boolean"
            }
          },
          "required": [
            "title",
            "body",
            "noteType",
            "paperIds",
            "tags",
            "pinned"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "data",
        "createdAt",
        "updatedAt",
        "version",
        "deleted"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "venue"
        },
        "data": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "abbreviation": {
              "type": "string"
            },
            "venueType": {
              "enum": [
                "journal",
                "conference"
              ]
            },
            "website": {
              "type": "string"
            },
            "submissionUrl": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "checkedOn": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "editions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "label": {
                    "type": "string"
                  },
                  "year": {
                    "type": "integer",
                    "minimum": 1900,
                    "maximum": 2200
                  },
                  "website": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "label",
                  "year",
                  "website",
                  "notes"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "name",
            "abbreviation",
            "venueType",
            "website",
            "submissionUrl",
            "notes",
            "checkedOn",
            "editions"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "data",
        "createdAt",
        "updatedAt",
        "version",
        "deleted"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "const": "deadline"
        },
        "data": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "deadlineType": {
              "enum": [
                "submission",
                "revision",
                "followup",
                "conference",
                "other"
              ]
            },
            "timing": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "precision": {
                      "const": "date"
                    },
                    "date": {
                      "type": "string",
                      "format": "date"
                    }
                  },
                  "required": [
                    "precision",
                    "date"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "precision": {
                      "const": "instant"
                    },
                    "at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "timezone": {
                      "type": "string"
                    },
                    "original": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "precision",
                    "at",
                    "timezone",
                    "original"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "paperId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "venueId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "editionId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sourceUrl": {
              "type": "string"
            },
            "checkedOn": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ]
            },
            "notes": {
              "type": "string"
            },
            "completed": {
              "type": "boolean"
            }
          },
          "required": [
            "title",
            "deadlineType",
            "timing",
            "paperId",
            "venueId",
            "editionId",
            "sourceUrl",
            "checkedOn",
            "notes",
            "completed"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "deleted": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "data",
        "createdAt",
        "updatedAt",
        "version",
        "deleted"
      ],
      "additionalProperties": false
    }
  ]
}
